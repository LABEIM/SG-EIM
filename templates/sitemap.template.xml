<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">

    <!-- Canonical Homepage -->
    <url>
        <loc>https://[YOUR_DOMAIN]/</loc>
        <lastmod>[YYYY-MM-DD]</lastmod>
        <changefreq>daily</changefreq>
        <priority>1.0</priority>
        <xhtml:link rel="alternate" hreflang="en" href="https://[YOUR_DOMAIN]/?lang=en" />
        <xhtml:link rel="alternate" hreflang="id" href="https://[YOUR_DOMAIN]/?lang=id" />
        <xhtml:link rel="alternate" hreflang="x-default" href="https://[YOUR_DOMAIN]/" />
    </url>

    <!-- Additional Routes (Example) -->
